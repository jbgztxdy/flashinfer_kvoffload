+      }
+    }
+    // The resolve step is done, so the dedup entries can be cleared for the next launch.
+    if (tid < rows && chunk * rows + tid < count) {
+      const auto page = [&]() {
+        if constexpr (Params::shared_fetch_ids)
+          return page_ids[buf][tid];
