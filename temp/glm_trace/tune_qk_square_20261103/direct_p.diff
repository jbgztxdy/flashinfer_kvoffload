+template <typename Q, typename KV, typename O, typename Id>
+struct SquarePTraits : JointQKTraits<Q, KV, O, Id> {
+  struct SharedStorage : JointQKTraits<Q,KV,O,Id>::SharedStorage {
+    alignas(16) float square_sum[2][2][64];
+    alignas(16) float square_anchor[64];
+  };
+};
+template <typename Params>
+struct SquarePHostParams : JointQKHostParams<Params> {};
