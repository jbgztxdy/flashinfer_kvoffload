--- a/include/flashinfer/attention/mla_host_batch.cuh
+++ b/include/flashinfer/attention/mla_host_batch.cuh
@@ -472,0 +473,17 @@
+  // A small batch's row-prefix scans fit in one warp. Other warps only need the completed
+  // shared-memory prefix and total; avoid the multi-warp carry scan and its extra barriers.
+  if (n <= 32) {
+    if (tid < 32) {
+      const uint32_t count = tid < n ? value(tid) : 0;
+      uint32_t sum = count;
+#pragma unroll
+      for (uint32_t offset = 1; offset < 32; offset *= 2) {
+        const uint32_t other = __shfl_up_sync(0xffffffff, sum, offset);
+        if (tid >= offset) sum += other;
+      }
+      if (tid < n) out[tid] = sum - count;
+      if (tid == 31) carry = sum;
+    }
+    __syncthreads();
+    return carry;
+  }
