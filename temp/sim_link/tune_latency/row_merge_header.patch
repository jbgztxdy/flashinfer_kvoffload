+  if (host_batch_row_merge(params)) {
+    const uint32_t tid = (threadIdx.z * blockDim.y + threadIdx.y) * blockDim.x + threadIdx.x;
+    if (tid == 0) {
+      while (host_batch_ld_acquire(host_batch_row_claims(params) + row) < states * params.num_head_tiles)
+        __nanosleep(64);
+    }
+    __syncthreads();
+  }
+}
